{
  "name": "@abdofawzi5/cclens",
  "version": "0.1.0",
  "description": "Claude Code Lens: skill inventory and usage, token stats, session optimization advice, and skill discovery across registries.",
  "type": "module",
  "license": "MIT",
  "author": "Abdelrahman Fawzi <abdofawzi5@gmail.com> (https://github.com/abdofawzi5)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdofawzi5/cclens.git"
  },
  "homepage": "https://github.com/abdofawzi5/cclens#readme",
  "bugs": {
    "url": "https://github.com/abdofawzi5/cclens/issues"
  },
  "bin": {
    "cclens": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "verify:apis": "node scripts/verify-apis.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-version.mjs && prettier --write package.json CHANGELOG.md plugin/.claude-plugin/plugin.json",
    "prepublishOnly": "pnpm check && pnpm build",
    "release": "changeset publish"
  },
  "keywords": [
    "claude",
    "claude-code",
    "skills",
    "usage",
    "tokens",
    "cli"
  ],
  "dependencies": {
    "ccusage": "^20.0.51",
    "chart.js": "^4.6.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
